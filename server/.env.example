# Copy to .env on the VPS (in this folder). Never commit .env.
#
# AI provider: if GEMINI_API_KEY (or GOOGLE_AI_API_KEY) is set, Gemini is used.
# Otherwise OPENAI_API_KEY is used.
#
# Gemini (free tier via Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — default gemini-2.0-flash; try gemini-1.5-flash if a model errors
# GEMINI_MODEL=gemini-1.5-flash

# Optional — only if you changed server.js defaults
# PORT=3000
# HOST=127.0.0.1
